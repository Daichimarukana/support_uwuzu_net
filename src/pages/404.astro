---
import Footer from '../components/footer.astro';
import Header from '../components/header.astro';
import "../styles/style.css";
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<title>404 Not Found | ゆずねっとサポート</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
	</head>
	<body>
		<Header />

		<main>
			<section class="top">
				<h1>404 Not Found</h1>
				<p class="subtitle">ごめん...ファイル見つからなかった...</p>
				<p>
                    申し訳ございません。お探しのページが見つかりませんでした。<br>
                    ページの移動や削除が行われた可能性がございます。<br>
                    右上の検索ボックスから検索をお試しください。
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
